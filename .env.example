# Supabase project credentials.
#
# Copy this file to `.env` and fill in the values from your Supabase dashboard:
#   Project Settings -> API
#
# The anon key is designed to ship inside the app: it is protected by Row Level
# Security, not by secrecy. The service-role key bypasses RLS and MUST NOT be
# placed in this file or anywhere else that ends up in the app bundle.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
